# Copy to .env.local for development. Never commit real values.
# Public values (browser-visible) must start with NEXT_PUBLIC_.

NEXT_PUBLIC_SITE_URL=
NODE_ENV=development

# Lead storage: file (dev / single server) | postgres (not implemented yet)
LEAD_STORE=file
DATA_DIR=

# Required in production for file-based leads/uploads (single server, persistent backed-up disk)
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=

# Media storage: local (dev / single server) | s3 (S3-compatible, production)
MEDIA_STORAGE=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=uploads

# CRM / automation webhook (optional; leads are saved even when unset)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=
CRM_WEBHOOK_TIMEOUT_MS=5000
CRM_WEBHOOK_MAX_ATTEMPTS=3

# Reverse proxy overwrites X-Forwarded-For (default "1"). Set "0" only when directly exposed.
TRUST_PROXY=1

# Optional public settings, WordPress headless CMS, and brand name (all optional)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_TELEGRAM=
NEXT_PUBLIC_EMAIL=
WP_API_URL=
