{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1240px",
      "wideSize": "1360px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "slug": "primary",
          "color": "#23414F",
          "name": "لجنی پیکسوا"
        },
        {
          "slug": "accent",
          "color": "#0D93A8",
          "name": "فیروزه‌ای ملایم"
        },
        {
          "slug": "cta",
          "color": "#E07B2A",
          "name": "نارنجی گرم"
        },
        {
          "slug": "background",
          "color": "#F7F6F1",
          "name": "کاغذی گرم"
        },
        {
          "slug": "text",
          "color": "#414B5A",
          "name": "متن اصلی"
        },
        {
          "slug": "muted",
          "color": "#6E7A8E",
          "name": "متن کم‌رنگ"
        },
        {
          "slug": "white",
          "color": "#FFFFFF",
          "name": "سفید"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "vazirmatn",
          "name": "وزیرمتن",
          "fontFamily": "\"Vazirmatn\", \"Tahoma\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Vazirmatn",
              "fontWeight": "100 900",
              "fontStyle": "normal",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/vazirmatn-variable.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        {"slug": "small", "size": "0.875rem", "name": "کوچک"},
        {"slug": "medium", "size": "1rem", "name": "متوسط"},
        {"slug": "large", "size": "1.375rem", "name": "بزرگ"},
        {"slug": "x-large", "size": "2.25rem", "name": "خیلی بزرگ"},
        {"slug": "xx-large", "size": "clamp(2.25rem, 5vw, 3.25rem)", "name": "تیتر اصلی"}
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%"],
      "spacingScale": {
        "operator": "*",
        "increment": 1.5,
        "steps": 7,
        "mediumStep": 1.5,
        "unit": "rem"
      }
    },
    "border": {
      "radius": true,
      "width": true,
      "style": true,
      "color": true
    },
    "custom": {
      "pixva": {
        "radius": {
          "sm": "8px",
          "md": "14px",
          "lg": "22px"
        }
      }
    }
  },
  "styles": {
    "color": {
      "background": "#F7F6F1",
      "text": "#414B5A"
    },
    "typography": {
      "fontFamily": "\"Vazirmatn\", \"Tahoma\", sans-serif",
      "lineHeight": "1.9"
    },
    "elements": {
      "h1": {"color": {"text": "#23414F"}, "typography": {"lineHeight": "1.4"}},
      "h2": {"color": {"text": "#23414F"}, "typography": {"lineHeight": "1.4"}},
      "h3": {"color": {"text": "#23414F"}, "typography": {"lineHeight": "1.5"}},
      "link": {"color": {"text": "#0D93A8"}},
      "button": {
        "color": {"background": "#E07B2A", "text": "#FFFFFF"},
        "border": {"radius": "14px"}
      }
    }
  },
  "templateParts": [
    {"name": "header", "area": "header", "title": "سربرگ"},
    {"name": "footer", "area": "footer", "title": "پانوشت"}
  ],
  "customTemplates": [
    {"name": "page-no-title", "title": "برگه بدون تیتر", "postTypes": ["page"]}
  ]
}
